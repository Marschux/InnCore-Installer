cat << 'EOF' | sudo tee -a /etc/mysql/mysql.conf.d/mysqld.cnf

# ==================================================
# MYSQL PERFORMANCE TUNING - AZEROTHCORE AUTHSERVER
# System: 2 cores / 2 GB RAM
# ==================================================

# InnoDB RAM cache
innodb_buffer_pool_size = 512M
innodb_buffer_pool_instances = 1
innodb_log_buffer_size = 16M

# Disk I/O
innodb_io_capacity = 200
innodb_io_capacity_max = 800
innodb_lock_wait_timeout = 50
innodb_deadlock_detect = ON

# Reduces write pressure.
# Small crash-risk window of about 1 second.
innodb_flush_log_at_trx_commit = 2

# Helps reduce lock/deadlock issues
transaction_isolation = READ-COMMITTED

# Disable binary logs if replication is not used
skip-log-bin

# Temporary tables
tmp_table_size = 32M
max_heap_table_size = 32M

# Connections
max_connections = 80
thread_cache_size = 32

# Table cache
table_open_cache = 1024
table_definition_cache = 512

# Slow query log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1
log_queries_not_using_indexes = 0

EOF